<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="false"
        android:icon="@drawable/ic_shortcut_refresh"
        android:shortcutId="refresh"
        android:shortcutShortLabel="@string/shortcut_refresh">
        <intent
            android:action="in.anoopbhatia.mail.REFRESH"
            android:targetClass="in.anoopbhatia.mail.debug.ActivityMain"
            android:targetPackage="in.anoopbhatia.mail.debug" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_edit"
        android:shortcutId="compose"
        android:shortcutShortLabel="@string/shortcut_compose">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="in.anoopbhatia.mail.ActivityCompose"
            android:targetPackage="in.anoopbhatia.mail.debug" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <share-target android:targetClass="in.anoopbhatia.mail.debug.ActivityCompose">
        <category android:name="in.anoopbhatia.mail.debug.TEXT_SHARE_TARGET" />
        <data android:mimeType="text/plain" />
    </share-target>
</shortcuts>