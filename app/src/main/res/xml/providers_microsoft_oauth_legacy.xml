<?xml version="1.0" encoding="utf-8"?>
<!-- Compatibility-only settings for refreshing or reauthorizing already-saved Microsoft OAuth records. Do not add this resource to setup menus. -->
<providers>
    <provider id="office365">
        <oauth
            askAccount="true"
            authorizationEndpoint="https://login.microsoftonline.com/{tenant}/oauth2/v2.0/authorize"
            clientId="DUMMY_MICROSOFT_OFFICE365_CLIENT_ID"
            clientSecret="DUMMY_MICROSOFT_CLIENT_SECRET"
            enabled="true"
            privacy="https://privacy.microsoft.com/privacystatement"
            prompt="login"
            redirectUri="https://example.invalid/DUMMY_OFFICE365_CALLBACK"
            scopes="profile,openid,email,offline_access,https://outlook.office.com/IMAP.AccessAsUser.All,https://outlook.office.com/SMTP.Send,https://outlook.office.com/POP.AccessAsUser.All"
            tokenEndpoint="https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token"
            tokenScopes="true" />
    </provider>
    <provider id="office365pcke">
        <oauth
            askAccount="true"
